{minimum_otp_vsn, "27"}.

{erl_opts, [
    debug_info,
    warnings_as_errors,
    warn_missing_spec,
    warn_export_vars,
    warn_unused_import,
    warn_obsolete_guard
]}.

%% Git refs until both land in a release: roadrunner's main with the
%% mechanisms this adapter uses, and Nova's pluggable server branch.
{deps, [
    {roadrunner,
        {git, "https://github.com/arizona-framework/roadrunner.git",
            {ref, "d505874a8d396f74e199d3f9a766871b04265006"}}},
    {nova, {git, "https://github.com/williamthome/nova.git", {branch, "feat/pluggable-server"}}}
]}.

{project_plugins, [
    {erlfmt, "1.8.0"},
    {rebar3_hank, "2.0.2"},
    {rebar3_hex, "7.5.0"},
    {rebar3_ex_doc, "0.3.0"}
]}.

{erlfmt, [
    write,
    {files, [
        "rebar.config",
        "src/*.{erl,hrl,app.src}",
        "test/*.{erl,hrl}"
    ]}
]}.

{profiles, [
    {test, [
        {erl_opts, [nowarn_export_all, nowarn_missing_spec]},
        {extra_src_dirs, [{"test", [{recursive, true}]}]},
        %% Nova's own test applications, which the end-to-end suite boots.
        {project_app_dirs, [".", "test/nova_test_app", "test/nova_test_sub_app"]}
    ]}
]}.

{cover_enabled, true}.
{cover_export_enabled, true}.
%% Nova's test applications are fixtures for the end-to-end suite.
{cover_excl_apps, [nova_test_app, nova_test_sub_app]}.

{ct_opts, [{sys_config, ["config/test.config"]}]}.

{dialyzer, [
    {warnings, [unknown, unmatched_returns, error_handling]},
    {plt_apps, top_level_deps},
    %% Nova's request map is Cowboy's (`cowboy_req:req()`), so the Cowboy
    %% types Nova brings along are part of this adapter's specs.
    {plt_extra_apps, [cowboy, cowlib, ranch, ssl, public_key]}
]}.

{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    locals_not_used,
    deprecated_function_calls,
    deprecated_functions
]}.

{hank, [
    {ignore, [
        %% Nova's test applications, as Nova's repository has them: their
        %% controllers take the request whether they read it or not.
        "test/nova_test_app/**",
        "test/nova_test_sub_app/**",
        %% Cowboy WebSocket callbacks have fixed arities.
        {"test/roadrunner_nova_ws_bare.erl", unnecessary_function_arguments}
    ]}
]}.

{ex_doc, [
    {extras, [
        "README.md",
        "CONTRIBUTING.md",
        "CHANGELOG.md",
        "LICENSE.md"
    ]},
    {main, "README.md"},
    {api_reference, true},
    {source_url, "https://github.com/arizona-framework/roadrunner_nova"},
    {prefix_ref_vsn_with_v, false}
]}.

{hex, [{doc, #{provider => ex_doc}}]}.

{alias, [
    {doc, [ex_doc]},
    {precommit, [
        {fmt, "--check"},
        compile,
        xref,
        hank,
        dialyzer,
        ex_doc,
        {eunit, "--cover"},
        {ct, "--cover"},
        {cover, "--verbose --min_coverage=100"}
    ]}
]}.
